# recalls — real-time alerts config (copy to .env; .env is gitignored)

# Which country to poll. Selects both the sources (sources registry) and the
# per-country database (_data/<country>.db). Default: us. Supported: us.
# RECALLS_COUNTRY=us

# Store backend behind the AlertStore port. Default: sqlite (single-machine).
# A cloud backend (e.g. postgres) is added as a new adapter, selected here.
# RECALLS_STORE=sqlite

# Override the per-country SQLite path (used when RECALLS_STORE=sqlite).
# Default: _data/<country>.db  (e.g. _data/us.db)
# RECALLS_DB_PATH=_data/us.db

# Override a source's RSS feed URL (single-source convenience). If unset, each
# source uses its own default (FDA's feed for the US).
# RECALLS_FEED_URL=

# HTTP User-Agent sent when fetching the feed (be a polite citizen).
# RECALLS_USER_AGENT=recalls-alerts/0.1 (+https://github.com/zen37/recalls)

# Log level for stdout logs. Default: INFO
# LOG_LEVEL=INFO
